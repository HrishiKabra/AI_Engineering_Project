# Copy to .env and fill in. The repo's existing .env uses OPENAI_KEY; the app
# also accepts OPENAI_API_KEY and exports whichever is set for the OpenAI SDK.

OPENAI_KEY=sk-...

# Optional overrides (defaults shown):
# CHAT_MODEL=gpt-4o-mini
# EMBED_MODEL=openai            # 'openai' (1536-dim) | 'bge' (768-dim, local, ablation)
# RETRIEVAL_MODE=hybrid         # dense | sparse | hybrid
# TOP_K=5
# RERANK_ENABLED=false          # cross-encoder rerank (local/ablation only)
# DATABASE_URL=postgresql://postgres:postgres@db:5432/f1rag
